<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PcHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#07060D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Sin ventana visible: la pantalla de compartir se cierra al tiro -->
    <style name="Theme.PcHub.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
</resources>
